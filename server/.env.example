PORT=3000
NODE_ENV=production

# MySQL (Aiven or cPanel MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=parstalk
MYSQL_SSL=false

# Session (change to a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional TURN server (for NAT traversal on national network)
# TURN_URL=turn:turn.example.ir:3478
# TURN_USERNAME=parstalk
# TURN_CREDENTIAL=secret
